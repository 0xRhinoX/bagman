{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bagman",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The game itself: plain static files. Requests that don't match a file (like /api/*) go to the worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bagman",
      // Live database (created with `npx wrangler d1 create bagman`). Local dev uses its own copy in .wrangler/.
      "database_id": "55537f00-a0ec-438f-b473-fb0acef3d396",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
